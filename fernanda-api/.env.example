# Este é um arquivo de exemplo para as variáveis de ambiente
# Copie este arquivo como .env e preencha com valores reais
# NÃO adicione valores sensíveis reais a este arquivo de exemplo

# Database - Utilize a string de conexão do seu banco PostgreSQL
DATABASE_URL="postgres://usuario:senha@host:porta/nome_banco?sslmode=disable"

# NextAuth (autenticação)
# Em desenvolvimento, use http://localhost:3000
# Em produção na Vercel, será preenchido automaticamente
NEXTAUTH_URL="http://localhost:3000"

# Chave secreta para tokens JWT (pode ser gerada com: openssl rand -base64 32)
NEXTAUTH_SECRET="sua_chave_secreta_aqui" 