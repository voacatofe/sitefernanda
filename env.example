# Este é um arquivo de exemplo das variáveis de ambiente necessárias
# Copie este arquivo como .env.local e preencha com valores reais
# NÃO adicione valores sensíveis reais a este arquivo de exemplo

# Prisma Database
DATABASE_URL="postgresql://usuario:senha@localhost:5432/nome_do_banco?sslmode=disable"

# Next Auth
# Em desenvolvimento, use http://localhost:3000
# Em produção, use a URL pública do seu site
NEXTAUTH_URL="http://localhost:3000"

# Gere um segredo forte para produção (pode usar: openssl rand -base64 32)
NEXTAUTH_SECRET="seu_segredo_aqui"

# Ambiente (development, production, test)
NODE_ENV="development" 