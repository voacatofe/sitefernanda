# Exemplo de configuração para ambiente de produção
# Copie este arquivo como .env.production e preencha com valores reais

# Prisma Database (somente se necessário em produção)
DATABASE_URL="postgresql://usuario:senha@host-producao:5432/nome_do_banco?sslmode=disable"

# Next Auth
# Deve ser a URL pública do site em produção
NEXTAUTH_URL="https://seu-dominio.com"

# Use o mesmo segredo em todos os ambientes
NEXTAUTH_SECRET="seu_segredo_aqui"

# Ambiente
NODE_ENV="production" 